{
  "name": "vamos-spanish",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "¡Vamos! — PWA-приложение для изучения латиноамериканского испанского языка (Nuxt 4 + DaisyUI 5 + Pug + TypeScript)",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "typecheck": "nuxt typecheck",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "nuxt": "^4.7.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/pug": "2.0.10",
    "@vite-pwa/nuxt": "^2.0.4",
    "@vue/test-utils": "2.6.0",
    "daisyui": "^5.8.2",
    "happy-dom": "21.0.4",
    "pug": "^3.0.4",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  }
}
